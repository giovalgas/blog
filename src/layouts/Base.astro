---
import StatusBar from "@/components/StatusBar.astro";
import LangToggle from "@/components/islands/LangToggle";
import { type Lang, type Window, ui } from "@/i18n/ui";
import "@/styles/global.css";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  active: Window;
  path: string;
  enHref?: string;
  ptHref?: string;
}

const { lang, title, description, active, path } = Astro.props;
const enHref = Astro.props.enHref ?? ui.en.home;
const ptHref = Astro.props.ptHref ?? ui.pt.home;
const canonical = new URL(Astro.url.pathname, Astro.site);

const gaId = "G-BP3Y0KL0XN";
const gaInit = `window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${gaId}');`;

const detectLang = `(function () {
  var target = document.currentScript.dataset.ptHref;
  var stored = null;
  try { stored = window.localStorage.getItem("lang"); } catch (error) {}
  if (stored === "en") return;
  if (stored === "pt" || (!stored && (navigator.language || "").toLowerCase().indexOf("pt") === 0)) {
    window.location.replace(target);
  }
})();`;
---

<!doctype html>
<html lang={ui[lang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(enHref, Astro.site)} />
    <link rel="alternate" hreflang="pt-BR" href={new URL(ptHref, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(enHref, Astro.site)} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${ui[lang].title} ${ui[lang].blogIndex.title}`}
      href={new URL(ui[lang].rss, Astro.site)}
    />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === "en" ? "en" : "pt_BR"} />
    {lang === "en" && <script is:inline data-pt-href={ptHref} set:html={detectLang} />}
    {
      import.meta.env.PROD && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
          <script is:inline set:html={gaInit} />
        </>
      )
    }
  </head>
  <body>
    <LangToggle
      client:idle
      lang={lang}
      enHref={enHref}
      ptHref={ptHref}
      label={ui[lang].toggleLabel}
    />
    <slot />
    <StatusBar lang={lang} active={active} path={path} />
  </body>
</html>
