{"nodes": [{"id": "specs_08_i18n_bilingual", "label": "Site bilingue en / pt-BR", "file_type": "concept", "source_file": "specs/08-I18N.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ingles e o padrao e fica sem prefixo; portugues mora sob /pt. Duas versoes de tudo: chrome, copy da home, titulos e corpo dos posts."}, {"id": "specs_08_i18n_routes", "label": "Tabela de rotas espelhadas (/ , /blog, /blog/<slug>, /rss.xml)", "file_type": "concept", "source_file": "specs/08-I18N.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_08_i18n_hreflang", "label": "hreflang e x-default", "file_type": "concept", "source_file": "specs/08-I18N.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "x-default aponta para a versao em ingles porque ingles e o idioma padrao sem prefixo."}, {"id": "specs_08_i18n_translation_key", "label": "translationKey no frontmatter", "file_type": "concept", "source_file": "specs/08-I18N.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "O slug diverge entre idiomas (observability-lgtm / observabilidade-lgtm), entao o par precisa de uma chave estavel para ligar as duas versoes."}, {"id": "specs_08_i18n_language_detection", "label": "Deteccao de idioma (script inline no head)", "file_type": "rationale", "source_file": "specs/08-I18N.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A URL manda, o navegador so decide quando o usuario ainda nao escolheu. Roda so nas paginas em ingles e antes da primeira pintura; nao pode ser ilha React porque piscaria o idioma errado. Paginas /pt/* nunca redirecionam para respeitar link direto."}, {"id": "specs_08_i18n_lang_toggle", "label": "Toggle de idioma", "file_type": "concept", "source_file": "specs/08-I18N.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Grava o idioma de destino em localStorage.lang: e essa escrita que faz a escolha explicita vencer a deteccao do navegador nas visitas seguintes. Sem traducao do post, cai no indice do blog do outro idioma."}, {"id": "specs_08_i18n_copy_details", "label": "Detalhes de copy bilingue (comandos, datas, contagens)", "file_type": "concept", "source_file": "specs/08-I18N.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Datas ficam em ISO nos dois idiomas (nao localizar formato) porque o site imita saida de terminal; 'ls ~/documents' e igual nos dois por ser comando real."}], "edges": [{"source": "specs_08_i18n_bilingual", "target": "specs_08_i18n_routes", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/08-I18N.md", "source_location": null, "weight": 1.0}, {"source": "specs_08_i18n_hreflang", "target": "specs_08_i18n_translation_key", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/08-I18N.md", "source_location": null, "weight": 1.0}, {"source": "specs_08_i18n_lang_toggle", "target": "specs_08_i18n_language_detection", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/08-I18N.md", "source_location": null, "weight": 1.0}, {"source": "specs_08_i18n_lang_toggle", "target": "specs_08_i18n_translation_key", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/08-I18N.md", "source_location": null, "weight": 1.0}, {"source": "specs_08_i18n_lang_toggle", "target": "specs_05_blog_blog_index", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "specs/08-I18N.md", "source_l