le_type": "concept", "source_file": "public/documents/giovani-valgas-cv-en.pdf", "source_location": "Experience", "source_url": "www.giovalgas.dev.br", "captured_at": "Aug 2026", "author": "Giovani Valgas", "contributor": null}, {"id": "public_documents_giovani_valgas_cv_en_lgtm_observability_migration", "label": "New Relic to LGTM stack migration with OpenTelemetry", "file_type": "rationale", "rationale": "Replaced New Relic with self-hosted Loki, Grafana, Tempo and Mimir instrumented via OpenTelemetry because vendor observability cost R$34,800/year for narrow coverage; the open stack raised coverage more than 4x while dropping estimated cost below R$8,000/year, trading vendor convenience for cost control and instrumentation ownership.", "source_file": "public/documents/giovani-valgas-cv-en.pdf", "source_location": "Experience > Tech Lead > Key Results", "source_url": "www.giovalgas.dev.br", "captured_at": "Aug 2026", "author": "Giovani Valgas", "contributor": null}, {"id": "public_documents_giovani_valgas_cv_en_frontend_php_to_reactjs_migration", "label": "Frontend stack migration from PHP to ReactJS", "file_type": "rationale", "rationale": "Coordinated a squad-wide rollout off PHP onto ReactJS, planned incrementally rather than as a single cutover so the platform kept shipping during the transition.", "source_file": "public/documents/giovani-valgas-cv-en.pdf", "source_location": "Experience > Tech Lead > Key Results", "source_url": "www.giovalgas.dev.br", "captured_at": "Aug 2026", "author": "Giovani Valgas", "contributor": null}, {"id": "public_documents_giovani_valgas_cv_en_cicd_runner_redesign", "label": "CI/CD runner setup redesign", "file_type": "rationale", "rationale": "Redesigned the CI/CD runner topology to cut spend from roughly R$16,500/year to under R$3,300/year, an over 80% reduction, treating build infrastructure as a cost surface rather than fixed overhead.", "source_file": "public/documents/giovani-valgas-cv-en.pdf", "source_location": "Experience > Tech Lead > Key Results", "source_url": "www.giovalgas.dev.br", "captured_at": "Aug 2026", "author": "Giovani Valgas", "contributor": null}, {"id": "public_documents_giovani_valgas_cv_en_docker_swarm_blue_green_traefik", "label": "Docker Swarm blue-green deployments via Traefik", "file_type": "rationale", "rationale": "Moved deploys off traditional servers onto Docker Swarm orchestrated containers with blue-green releases fronted by Traefik; deployment time fell from 1h30m to under 10 minutes (nearly 90%) while gaining scalability and portability.", "source_file": "public/documents/giovani-valgas-cv-en.pdf", "source_location": "Experience > Senior Software Engineer > Key Results", "source_url": "www.giovalgas.dev.br", "captured_at": "Aug 2026", "author": "Giovani Valgas", "contributor": null}, {"id": "public_documents_giovani_valgas_cv_en_keycloak_sso", "label": "Keycloak-based Single Sign-On", "file_type": "rationale", "rationale": "Delivered SSO on Keycloak 50% ahead of plan by adopting an existing identity provider instead of building auth in-house, improving the login experience without owning credential storage.", "source_file": "public/documents/giovani-valgas-cv-en.pdf", "source_location": "Experience > Senior Software Engineer > Key Results", "source_url": "www.giovalgas.dev.br", "captured_at": "Aug 2026", "author": "Giovani Valgas", "contributor": null}, {"id": "public_documents_giovani_valgas_cv_en_infrastructure_as_code", "label": "Infrastructure as Code with Terraform and Pulumi", "file_type": "rationale", "rationale": "AWS resources are declared in Terraform and Pulumi rather than provisioned by hand, so deployments stay consistent and reproducible as the environment scales.", "source_file": "public/documents/giovani-valgas-cv-en.pdf", "source_location": "Experience > Senior Software Engineer > Key Results", "source_url": "www.giovalgas.dev.br", "captured_at": "Aug 2026", "author": "Giovani Valgas", "contributor": null}, {"id": "public_documents_giovani_valgas_cv_en_grafana_stack_observability", "label": "Grafana stack observability at Radar Saude", "file_type": "concept", "source_file": "public/documents/giovani-valgas-cv-en.pdf", "source_location": "Experience > Software Engineer, Radar Saude > Key Results", "source_url": "www.giovalgas.dev.br", "captured_at": "Aug 2026", "author": "Giovani Valgas", "contributor": null}, {"id": "public_documents_giovani_valgas_cv_en_newrelic_cloudwatch_sentry_monitoring", "label": "New Relic, AWS CloudWatch and Sentry monitoring", "file_type": "concept", "source_file": "public/documents/giovani-valgas-cv-en.pdf", "source_location": "Experience > Senior Software Engineer > Key Results", "source_url": "www.giovalgas.dev.br", "captured_at": "Aug 2026", "author": "Giovani Valgas", "contributor": null}, {"id": "public_documents_giovani_valgas_cv_en_spring_boot_microservices", "label": "Spring Framework microservices scaling to 400+ clients", "file_type": "concept", "source_file": "public/documents/giovani-valgas-cv-en.pdf", "source_location": "Experience > Software Engineer, Radar Saude > Key Results", "source_url": "www.giovalgas.dev.br", "captured_at": "Aug 2026", "author": "Giovani Valgas", "contributor": null}, {"id": "public_documents_giovani_valgas_cv_en_bash_gitflow_deploy_automation", "label": "Bash deploy automation aligned with Git Flow", "file_type": "rationale", "rationale": "Deploy steps were scripted in Bash and shaped around the team's Git Flow branching model, halving deploy time; GitHub Actions pipelines carried the same flow.", "source_file": "public/documents/giovani-valgas-cv-en.pdf", "source_location": "Experience > Software Engineer, Radar Saude > Key Results", "source_url": "www.giovalgas.dev.br", "captured_at": "Aug 2026", "author": "Giovani Valgas", "contributor": null}, {"id": "public_documents_giovani_valgas_cv_en_spigot_minecraft_plugins", "label": "Optimized Java plugins for Spigot Minecraft servers", "file_type": "concept", "source_file": "public/docu